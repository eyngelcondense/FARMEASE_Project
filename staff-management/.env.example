# Environment variables for staff-management
# Copy this to .env and fill values for each deployment

SSO_TOKEN_TTL=30
SSO_SECRET_KEY=change_me_replace_with_a_strong_secret
SSO_LOGIN_URL=https://sso.example.com/login
SSO_GROUP_URL_STAFF=https://staff.example.com
SSO_GROUP_URL_STUDIO=https://studio.example.com
SSO_LANDING_STAFF=https://staff.example.com/staff/dashboard
SSO_LANDING_STUDIO=https://studio.example.com/studio/dashboard
